# App Store Connect API key, for uploading to TestFlight without Xcode's
# Organizer and without typing a password into a prompt.
#
# Copy this to scripts/appstore.env, which git ignores, and fill it in.
# The .p8 file is a credential that can upload builds under your name: keep it
# out of the repository and out of chat.
#
# Make the key at https://appstoreconnect.apple.com under
# Users and Access -> Integrations -> App Store Connect API -> Team Keys.
# Role "App Manager" is enough. The .p8 downloads once and only once.

ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ASC_KEY_PATH=~/private_keys/AuthKey_XXXXXXXXXX.p8
